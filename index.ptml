    <body>

<!--include menu.txt -->

        <section class="hero">
            <div class="hero-text">
                <p class="eyebrow">
                    Logic &middot; Sets &middot; Counting &middot; Graphs
                </p>
                <h1 class="toc-head">
                    Discrete Mathematics
                </h1>
                <p class="hero-lead">
                    Course notes on logic and proof, sets and functions,
                    number theory, induction, counting, probability,
                    relations, graphs, trees, Boolean algebra, and models
                    of computation.
                </p>
                <p class="hero-actions">
                    <a class="button primary" href="#topics">
                        Browse the topics
                    </a>
                    <a class="button" href="https://github.com/gcallah/DiscreteMathematics">
                        View on GitHub
                    </a>
                </p>
            </div>
            <img class="hero-art" src="graphics/hero.svg"
                 width="560" height="400"
                 alt="A graph whose vertices are colored with four colors so that no two neighbors share a color">
        </section>

        <figure class="feature-card">
            <img src="graphics/FourColourMap.svg.png"
                 width="292" height="174"
                 alt="A map colored with four colors">
            <figcaption>
                Four colors are always enough to color any map so that no
                two neighboring regions share a color: one of the most
                famous results in discrete mathematics, and the first major
                theorem proved with the help of a computer.
                <cite>
                    Four-color graphic by
                    <a href="https://commons.wikimedia.org/wiki/User:Inductiveload">Inductiveload</a>
                </cite>
            </figcaption>
        </figure>

